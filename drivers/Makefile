GXX = g++
GPP_PARAMS = -m32 -g -ffreestanding -I../include -fno-use-cxa-atexit -nostdlib -fno-builtin -fno-rtti -fno-exceptions -fno-common -c -fno-pic -MMD -MP

BUILD_DIR = ../build/drivers

# List of drivers to build
DRIVERS = $(BUILD_DIR)/bga.sys \
	  $(BUILD_DIR)/ac97.sys

# -MMD derives each .d name from its -o output, so the files land next to the
# .sys files rather than beside the sources.
DRIVER_DEPS = $(DRIVERS:.sys=.d)

all: $(DRIVERS)

$(BUILD_DIR)/%.sys: %.cpp
	mkdir -p $(BUILD_DIR)
	$(GXX) $(GPP_PARAMS) -o $@ $<

# Header dependency files generated by -MMD -MP, mirroring the kernel build.
-include $(DRIVER_DEPS)

clean:
	rm -rf $(BUILD_DIR)
